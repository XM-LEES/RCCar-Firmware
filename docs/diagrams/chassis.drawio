        </mxCell>
        <mxCell id="host" value="&lt;b&gt;上位机&lt;/b&gt;&lt;br&gt;目标速度 / 前轮转角&lt;br&gt;11B 命令 / 24B 状态&lt;br&gt;原命令与标志语义" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="215" width="290" height="150" />
        </mxCell>
        <mxCell id="hostio" value="&lt;b&gt;上位机通信&lt;/b&gt;&lt;br&gt;UART4 · 115200 / 8N1&lt;br&gt;PC11 RX / PC10 TX&lt;br&gt;命令有效性与停止覆盖" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="415" y="210" width="325" height="145" />
        </mxCell>
        <mxCell id="steering" value="&lt;b&gt;转向映射&lt;/b&gt;&lt;br&gt;角度与变化率限制&lt;br&gt;沿用端点线性插值&lt;br&gt;请求输出受原脉宽边界约束" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="195" width="320" height="145" />
        </mxCell>
        <mxCell id="longitudinal" value="&lt;b&gt;自动纵向控制&lt;/b&gt;&lt;br&gt;目标速度直接进入PID&lt;br&gt;Kp/Ki/Kd与实际输出跟踪&lt;br&gt;前进主动制动、倒车滑停&lt;br&gt;非对称模式二门控" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="410" width="320" height="180" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;输出仲裁与PWM边界&lt;/b&gt;&lt;br&gt;RC 接管 ＞ 串口控制源&lt;br&gt;RC油门保留接收机完整行程&lt;br&gt;无生效控制源 → 中点&lt;br&gt;转向：PC7 / TIM8 CH2&lt;br&gt;电调：PC6 / TIM8 CH1&lt;br&gt;保留接管与输入诊断" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="210" width="300" height="380" />
        </mxCell>
        <mxCell id="servos" value="&lt;b&gt;两只转向舵机&lt;/b&gt;&lt;br&gt;一个现有逻辑 PWM 通道&lt;br&gt;应用角由实际输出反算" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="220" width="320" height="130" />
        </mxCell>
        <mxCell id="esc" value="&lt;b&gt;HOBBYWING MAX5 HV G2&lt;/b&gt;&lt;br&gt;模式二：前进 / 刹车 / 倒车&lt;br&gt;遥测 eRPM / V / A / 温度&lt;br&gt;PD15接收FE32遥测" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="445" width="320" height="180" />
        </mxCell>
        <mxCell id="rc" value="&lt;b&gt;RC 接收输入&lt;/b&gt;&lt;br&gt;保留基线控制路径&lt;br&gt;油门 / 转向&lt;br&gt;PD14 未接线" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="475" width="290" height="145" />
        </mxCell>
        <mxCell id="rc_capture" value="&lt;b&gt;RC 采集与有效性&lt;/b&gt;&lt;br&gt;PD12 油门 / PD13 转向&lt;br&gt;TIM4 CH1 / CH2&lt;br&gt;脉宽捕获、滤波与异常诊断" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="415" y="475" width="325" height="145" />
        </mxCell>
        <mxCell id="battery" value="&lt;b&gt;电池电压采样&lt;/b&gt;&lt;br&gt;板载分压输入&lt;br&gt;既有 battery_mv 来源" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#faf5ff;strokeColor=#7e22ce;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="780" width="290" height="130" />
        </mxCell>
        <mxCell id="adc" value="&lt;b&gt;板载电压采集&lt;/b&gt;&lt;br&gt;PC2 / ADC1_IN12&lt;br&gt;raw / 4095 × 3.3 × 11 V&lt;br&gt;与 ESC 电压分别记录" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#faf5ff;strokeColor=#7e22ce;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="415" y="775" width="325" height="130" />
        </mxCell>
        <mxCell id="estimate" value="&lt;b&gt;运动估计：主速度来源&lt;/b&gt;&lt;br&gt;轮轴RPM = rpm_raw × 0.14115&lt;br&gt;|v| = 轮轴RPM × 2πR / 60&lt;br&gt;按反馈动作与命令上下文判向&lt;br&gt;无效速度不替换为有效零值" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#ecfdf5;strokeColor=#0f766e;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="785" width="320" height="180" />
        </mxCell>
        <mxCell id="escrx" value="&lt;b&gt;ESC 采集（PD15）&lt;/b&gt;&lt;br&gt;编程口 → PD15 / EXTI + TIM5&lt;br&gt;115200 / 8N1 位中心采样&lt;br&gt;FE32 · CRC16 / MODBUS&lt;br&gt;样本标识 / 时间 / 有效性" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#0f172a;fillColor=#ecfdf5;strokeColor=#0f766e;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="785" width="300" height="180" />
        </mxCell>
        <mxCell id="hall" value="&lt;b&gt;轮侧 Hall A / B&lt;/b&gt;&lt;br&gt;原 PE13 / PE14 接线&lt;br&gt;上拉、下降沿触发&lt;br&gt;不假定为正交编码器" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#faf5ff;strokeColor=#7e22ce;spacing=8;" vertex="1" parent="1">
