        <mxCell id="mag" value="&lt;b&gt;v参考&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;spacing=8;strokeColor=none;" vertex="1" parent="1">
