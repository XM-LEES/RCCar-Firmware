        <mxCell id="pi" value="&lt;b&gt;前馈 + PI 微调（µs）&lt;/b&gt;&lt;br&gt;p前馈 = F方向(v参考)&lt;br&gt;e = v参考 − v反馈&lt;br&gt;Δp = clip(Kp·e + Ki·∫e dt)&lt;br&gt;p推进 = p前馈 + Δp" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="175" width="275" height="155" />
        </mxCell>
        <mxCell id="actions" value="&lt;b&gt;电调动作约束&lt;/b&gt;&lt;br&gt;推进 / 制动 / 倒车 / 中点&lt;br&gt;推进与刹车分别限幅&lt;br&gt;PI 微调不能跨入另一动作区&lt;br&gt;制动独立映射，不套倒车限幅" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="175" width="280" height="155" />
        </mxCell>
        <mxCell id="plant" value="&lt;b&gt;执行与传动&lt;/b&gt;&lt;br&gt;PWM → ESC → 电机&lt;br&gt;波箱 → 轮端 → 车轮&lt;br&gt;响应包含饱和与时延" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1555" y="175" width="225" height="155" />
        </mxCell>
        <mxCell id="telemetry" value="&lt;b&gt;ESC 遥测（未验证）&lt;/b&gt;&lt;br&gt;校验 / 字段有效性&lt;br&gt;接收时刻 / 样本标识&lt;br&gt;eRPM 只有幅值" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#ecfdf5;strokeColor=#0f766e;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1555" y="420" width="225" height="140" />
        </mxCell>
        <mxCell id="conversion" value="&lt;b&gt;传动换算&lt;/b&gt;&lt;br&gt;轮轴RPM = rpm_raw × 0.14115&lt;br&gt;|v| = 轮轴RPM × 2πR / 60&lt;br&gt;低档实测系数与轮胎半径须有效" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#ecfdf5;strokeColor=#0f766e;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="420" width="280" height="140" />
        </mxCell>
        <mxCell id="fresh" value="&lt;b&gt;反馈使用约束&lt;/b&gt;&lt;br&gt;幅值 + 动作方向 → v反馈&lt;br&gt;新样本更新，不重复积分&lt;br&gt;无效反馈禁止自动推进" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#ecfdf5;strokeColor=#0f766e;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="420" width="275" height="140" />
        </mxCell>
        <mxCell id="brake_p" value="&lt;b&gt;前进的比例刹车支路&lt;/b&gt;&lt;br&gt;b = clip[Kb × (|v反馈| − |v参考|)]&lt;br&gt;切入 / 释放带滞回；制动请求先撤销原有推进" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#b91c1c;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="635" width="610" height="125" />
        </mxCell>
        <mxCell id="permission" value="&lt;b&gt;自动控制的运行权限&lt;/b&gt;&lt;br&gt;命令超时 / RPM 无效 / 关键参数缺失：取消自动推进&lt;br&gt;保留 RC 仲裁；SOFTWARE_STOP 按串口命令生效&lt;br&gt;CLEAR_FAULT 只按原条件处理故障诊断" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#64748b;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="635" width="700" height="125" />
        </mxCell>
        <mxCell id="stop_evidence" value="&lt;b&gt;停稳：N 个不同的新鲜低速样本覆盖指定时长；新动作之前的证据失效。&lt;/b&gt;&lt;br&gt;速度符号来自动作历史估计；停稳窗口不等于机械锁止或驻车制动。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=none;strokeColor=#64748b;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="790" width="1740" height="75" />
        </mxCell>
        <mxCell id="feedforward_reference" value="&lt;b&gt;v参考 → 原前馈表&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="111" width="270" height="28" />
        </mxCell>
        <mxCell id="minus" value="&lt;b&gt;− v反馈&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#0f766e;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690" y="365" width="130" height="28" />
        </mxCell>
        <mxCell id="b_label" value="&lt;b&gt;制动幅值 b&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b91c1c;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1170" y="345" width="165" height="28" />
        </mxCell>
        <mxCell id="states" value="&lt;b&gt;模式二动作关系&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#0f172a;fillColor=none;strokeColor=#2563eb;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="890" width="1740" height="42" />
        </mxCell>
        <mxCell id="forward" value="&lt;b&gt;前进驱动&lt;/b&gt;&lt;br&gt;正向 PWM：推进&lt;br&gt;新鲜运动样本确认正向历史" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="985" width="290" height="115" />
        </mxCell>
        <mxCell id="braking" value="&lt;b&gt;前进制动&lt;/b&gt;&lt;br&gt;第一次负向 PWM：刹车&lt;br&gt;同次制动连续保持负向区" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#b91c1c;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="510" y="985" width="290" height="115" />
        </mxCell>
        <mxCell id="neutral_dwell" value="&lt;b&gt;回中驻留&lt;/b&gt;&lt;br&gt;刹车达标并取得新停稳证据&lt;br&gt;保持中点至驻留完成" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="985" width="290" height="115" />
        </mxCell>
        <mxCell id="reverse" value="&lt;b&gt;倒车驱动&lt;/b&gt;&lt;br&gt;第二次负向 PWM：倒车&lt;br&gt;超速时用正向侧主动刹车" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="985" width="290" height="115" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;上电 / 恢复等待&lt;/b&gt;&lt;br&gt;受限正向探测&lt;br&gt;新鲜运动样本确认或超时回中" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#64748b;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1235" width="290" height="115" />
        </mxCell>
        <mxCell id="neutral" value="&lt;b&gt;中点等待&lt;/b&gt;&lt;br&gt;目标 0：保持中点&lt;br&gt;未知状态禁止直接倒车" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="510" y="1235" width="290" height="115" />
        </mxCell>
        <mxCell id="first_hit" value="&lt;b&gt;证据不足禁止&lt;/b&gt;&lt;br&gt;刹车未达力度或保持时间&lt;br&gt;回中后不自动补发同侧信号" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1235" width="290" height="115" />
        </mxCell>
        <mxCell id="reconfirm" value="&lt;b&gt;双向对称资格&lt;/b&gt;&lt;br&gt;F→R 与 R→F 阈值独立&lt;br&gt;最终实际 PWM 连续达标" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#fff7ed;strokeColor=#b45309;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="1235" width="290" height="115" />
        </mxCell>
        <mxCell id="coast" value="&lt;b&gt;倒车制动&lt;/b&gt;&lt;br&gt;正向侧信号主动刹车&lt;br&gt;停稳、回中后才可前进&lt;br&gt;明确换向请求设超时边界" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#64748b;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="1460" width="290" height="120" />
        </mxCell>
        <mxCell id="constraints" value="&lt;b&gt;动作约束&lt;/b&gt;&lt;br&gt;回中后不自动补发同侧刹车；同侧信号此时可能已是推进。&lt;br&gt;夹入零速命令不能绕过换向停稳；双向主动刹车分别标定。&lt;br&gt;未知状态禁止负向动作；受限正向探测须由新鲜运动样本确认。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#64748b;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1445" width="1160" height="125" />
        </mxCell>
        <mxCell id="fwd_brake" value="&lt;b&gt;超速 / 停车&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b91c1c;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="365" y="1008" width="140" height="28" />
        </mxCell>
        <mxCell id="brake_reverse" value="&lt;b&gt;刹车达标并停稳&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b45309;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="798" y="1008" width="155" height="28" />
        </mxCell>
        <mxCell id="dwell_done" value="&lt;b&gt;驻留完成&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b45309;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1245" y="1008" width="140" height="28" />
        </mxCell>
        <mxCell id="resume_fwd" value="&lt;b&gt;继续前进：释放制动后重新正推&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="165" y="922" width="500" height="28" />
        </mxCell>
        <mxCell id="stop_zero" value="&lt;b&gt;目标 0 且停稳&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#64748b;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="568" y="1160" width="175" height="28" />
        </mxCell>
        <mxCell id="initial_stopped" value="&lt;b&gt;新的停稳证据&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#64748b;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="365" y="1256" width="140" height="28" />
        </mxCell>
        <mxCell id="positive" value="&lt;b&gt;目标前进&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="1164" width="295" height="28" />
        </mxCell>
        <mxCell id="negative" value="&lt;b&gt;已知前进且无首击&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b45309;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="1256" width="150" height="28" />
        </mxCell>
        <mxCell id="release_first" value="&lt;b&gt;触发后回中&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b45309;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="1256" width="150" height="28" />
        </mxCell>
        <mxCell id="new_stop" value="&lt;b&gt;新的停稳证据&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#b45309;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="1146" width="450" height="28" />
        </mxCell>
        <mxCell id="forward_after_coast" value="&lt;b&gt;停稳后：正目标才进入前进；零目标回到中点等待&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#64748b;spacing=8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="365" y="1573" width="845" height="28" />
        </mxCell>
      </root>
    </mxGraphModel>
