        <mxCell id="title" value="&lt;b&gt;RC 线控底盘 · 系统架构&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#0f172a;fillColor=none;strokeColor=#2563eb;spacing=8;strokeColor=none;" vertex="1" parent="1">
